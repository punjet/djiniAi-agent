            "text": ".dashboard-card{display:flex;flex-direction:column;gap:.25rem;padding:.5rem 1rem;border-radius:var(--border-radius)}.dashboard-card__header{flex:0 0 auto}.dashboard-card__body{flex:1 1 auto;min-height:0;overflow:hidden}.dashboard-card__footer{flex:0 0 auto}.js-card-dismiss.btn-close{width:10px;height:10px;padding:0;background-size:10px 10px;z-index:5;opacity:.6}.js-card-dismiss.btn-close:hover,.js-card-dismiss.btn-close:focus{opacity:1}.dashboard-cards-carousel .dashboard-card{height:170px}.dashboard-cards-carousel .carousel-indicators{position:static;margin:.5rem 0 0}.dashboard-cards-carousel .carousel-indicators [data-bs-target]{width:5px;height:5px;border-radius:50%;background-color:var(--primary);border:none;margin:0 3px;text-indent:0;opacity:.3;transition:opacity .2s ease}.dashboard-cards-carousel .carousel-indicators [data-bs-target].active{opacity:1}.dashboard-cards-carousel .carousel-control-prev,.dashboard-cards-carousel .carousel-control-next{width:25%;top:0;bottom:auto;height:170px;background:transparent;opacity:1;transition:background .2s ease}.dashboard-cards-carousel .carousel-control-prev .carousel-control-prev-icon,.dashboard-cards-carousel .carousel-control-prev .carousel-control-next-icon,.dashboard-cards-carousel .carousel-control-next .carousel-control-prev-icon,.dashboard-cards-carousel .carousel-control-next .carousel-control-next-icon{display:none}.dashboard-cards-carousel .carousel-control-prev{border-top-left-radius:var(--border-radius);border-bottom-left-radius:var(--border-radius)}.dashboard-cards-carousel .carousel-control-next{border-top-right-radius:var(--border-radius);border-bottom-right-radius:var(--border-radius)}@media(hover:hover){.dashboard-cards-carousel .carousel-control-prev:hover,.dashboard-cards-carousel .carousel-control-prev:active{background:linear-gradient(to right,rgba(var(--primary-rgb),.25),transparent)}.dashboard-cards-carousel .carousel-control-next:hover,.dashboard-cards-carousel .carousel-cont