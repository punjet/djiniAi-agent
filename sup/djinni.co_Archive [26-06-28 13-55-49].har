          "content": {
            "mimeType": "application/javascript; charset=utf-8",
            "size": 2191,
            "text": "(function () {\n  const DISMISS_URL = \"/ajax/dashboard_card_dismiss/\";\n  const VIEW_EVENT = \"dashboard_card_viewed\";\n  const CAROUSEL_INTERVAL_MS = 7000;\n\n  function getCsrfToken() {\n    return document.body && document.body.dataset\n      ? document.body.dataset.csrfToken\n      : null;\n  }\n\n  function trackCardView(cardEl) {\n    if (!cardEl || cardEl.dataset.viewTracked) return;\n    cardEl.dataset.viewTracked = \"true\";\n\n    const cardId = cardEl.getAttribute(\"data-card-id\");\n    const candidateId = cardEl.getAttribute(\"data-candidate-id\");\n    if (!cardId || typeof window.trackEvent !== \"function\") return;\n\n    const additionalInfo = { card_id: cardId };\n    // Carried for whats_new cards so view counts can be attributed to a\n    // specific product update entry.\n    const updateId = cardEl.getAttribute(\"data-update-id\");\n    if (updateId) additionalInfo.update_id = updateId;\n\n    const payload = { additional_info: additionalInfo };\n    if (candidateId) payload.candidate_id = candidateId;\n\n    window.trackEvent(VIEW_EVENT, payload);\n  }\n\n  function findCarouselItem(el) {\n    let node = el;\n    while (node && node !== document.body) {\n      if (node.classList && node.classList.contains(\"carousel-item\")) {\n        return node;\n      }\n      node = node.parentNode;\n    }\n    return null;\n  }\n\n  function findCarouselRoot(el) {\n    let node = el;\n    while (node && node !== document.body) {\n      if (node.classList && node.classList.contains(\"carousel\")) {\n        return node;\n      }\n      node = node.parentNode;\n    }\n    return null;\n  }\n\n  function removeCarouselSlide(slide) {\n    const carousel = findCarouselRoot(slide);\n    if (!carousel) {\n      slide.remove();\n      return;\n    }\n\n    const bs = window.bootstrap && window.bootstrap.Carousel;\n    const instance = bs ? window.bootstrap.Carousel.getInstance(carousel) : null;\n    if (instance) {\n      instance.pause();\n      // Bootstrap's touch/swipe handler arms `touchTimeout` to call\n      // `_maybeEnableCycle()` ~7.5s later; dispose() doesn't clear it, so a\n      // swipe-then-dismiss leaves it firing on a disposed instance whose\n      // `_config` is now null (TypeError: can't access property \"ride\").\n      if (instance.touchTimeout) {\n        clearTimeout(instance.touchTimeout);\n      }\n      instance.dispose();\n    }\n\n    const indicator = carousel.querySelector(\n      '.carousel-indicators [data-card-id=\"' +\n        slide.getAttribute(\"data-card-id\") +\n        '\"]'\n    );\n    if (indicator) indicator.remove();\n\n    slide.remove();\n\n    const remaining = carousel.querySelectorAll(\".carousel-item\");\n    if (remaining.length === 0) {\n      carousel.remove();\n      return;\n    }\n\n    // Reset transition + active state across all remaining slides, then\n    // promote the first one. Bootstrap's mid-flight transition classes\n    // (carousel-item-{start,end,next,prev}) can linger if a slide is\n    // yanked during an animation; clear them so the next init is clean.\n    remaining.forEach((item) => {\n      item.classList.remove(\n        \"active\",\n        \"carousel-item-start\",\n        \"carousel-item-end\",\n        \"carousel-item-next\",\n        \"carousel-item-prev\"\n      );\n    });\n    remaining[0].classList.add(\"active\");\n\n    // Re-index the indicators. `data-bs-slide-to` originally encoded the\n    // server-side card order; once a slide is gone those indices point at\n    // gaps (e.g. clicking the 4th indicator tries to navigate to the\n    // missing 3rd slide). Re-number them to match the current DOM order\n    // and reset which one is highlighted.\n    const remainingIndicators = carousel.querySelectorAll(\n      \".carousel-indicators [data-bs-slide-to]\"\n    );\n    remainingIndicators.forEach((ind, idx) => {\n      ind.setAttribute(\"data-bs-slide-to\", String(idx));\n      ind.classList.remove(\"active\");\n      ind.removeAttribute(\"aria-current\");\n    });\n    if (remainingIndicators.length > 0) {\n      remainingIndicators[0].classList.add(\"active\");\n      remainingIndicators[0].setAttribute(\"aria-current\", \"true\");\n    }\n\n    // With only one card left there's nothing to cycle — drop the chrome\n    // and skip the re-init.\n    if (remaining.length === 1) {\n      const indicators = carousel.querySelector(\".carousel-indicators\");\n      if (indicators) indicators.remove();\n      carousel\n        .querySelectorAll(\".carousel-control-prev, .carousel-control-next\")\n        .forEach(function (btn) {\n          btn.remove();\n        });\n      return;\n    }\n\n    if (bs) {\n      new window.bootstrap.Carousel(carousel, {\n        interval: CAROUSEL_INTERVAL_MS,\n        pause: \"hover\",\n        ride: \"carousel\",\n      });\n    }\n  }\n\n  function dismissCard(cardId, sourceEl) {\n    if (!cardId) return;\n\n    const cardEl = sourceEl.closest(\".js-dashboard-card\");\n    trackCardView(cardEl);\n\n    const csrfToken = getCsrfToken();\n    const formData = new FormData();\n    formData.append(\"card_id\", cardId);\n    if (csrfToken) formData.append(\"csrfmiddlewaretoken\", csrfToken);\n\n    const headers = {};\n    if (csrfToken) headers[\"X-CSRFToken\"] = csrfToken;\n\n    fetch(DISMISS_URL, {\n      method: \"POST\",\n      credentials: \"same-origin\",\n      headers: headers,\n      body: formData,\n    }).then(function (resp) {\n      if (!resp.ok) return;\n      const slide = findCarouselItem(sourceEl);\n      if (slide) {\n        removeCarouselSlide(slide);\n      } else if (cardEl) {\n        cardEl.remove();\n      }\n    });\n  }\n\n  function wireViewTracking() {\n    document.querySelectorAll(\".js-dashboard-card\").forEach(function (card) {\n      // Desktop hover\n      card.addEventListener(\n        \"mouseenter\",\n        function () {\n          trackCardView(card);\n        },\n        { once: true }\n      );\n      // Mobile tap (and desktop click anywhere on the card body)\n      card.addEventListener(\n        \"touchstart\",\n        function () {\n          trackCardView(card);\n        },\n        { once: true, passive: true }\n      );\n      card.addEventListener(\n        \"click\",\n        function () {\n          trackCardView(card);\n        },\n        { once: true }\n      );\n    });\n  }\n\n  document.addEventListener(\"click\", function (event) {\n    const btn = event.target.closest(\".js-card-dismiss\");\n    if (!btn) return;\n    event.preventDefault();\n    event.stopPropagation();\n    dismissCard(btn.getAttribute(\"data-card-id\"), btn);\n  });\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", wireViewTracking);\n  } else {\n    wireViewTracking();\n  }\n})();\n"
          },
