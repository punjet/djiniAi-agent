er-gonka-network-mining/\"\n          rel=\"nofollow\"\n          class=\"dropdown-item\"\n        >\n          <span class=\"text-secondary\">Switch to English</span>\n        </a>\n      </li>\n    \n  \n    \n  \n  <li class=\"mb-0\">\n    <select\n  class=\"custom-select border-0 flex-grow w-100 px-3 py-1 h-auto bg-transparent text-secondary\"\n  style=\"-webkit-appearance: none; appearance: none;\"\n  onclick=\"event.stopPropagation();\"\n  data-toggle=\"color-theme\">\n  <option value=\"auto\" selected>Тема: авто</option>\n  <option value=\"dark\">Темна тема</option>\n  <option value=\"light\">Світла тема</option>\n</select>\n  </li>\n  <li>\n    <a href=\"/account_select/\" class=\"dropdown-item\">\n      <span class=\"text-secondary\">\n        Акаунт рекрутера\n      </span>\n    </a>\n  </li>\n  <li>\n    <a href=\"/logout\" class=\"dropdown-item\">\n      <span class=\"text-secondary\">Вийти</span>\n    </a>\n  </li>\n\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      \n      <ul class=\"nav navbar-nav header-dropdown--menu-mobile py-3\">\n        \n          \n  \n\n  <li>\n    <a href=\"/my/profile/\" class=\"dropdown-item\">\n      Профіль\n    </a>\n  </li>\n\n  <li>\n    <a\n      href=\"/updates/\"\n      class=\"dropdown-item d-flex align-items-center justify-content-between\"\n    >\n      <span>Що нового</span>\n      \n        <span\n          class=\"d-inline-block rounded-circle bg-danger ms-2\"\n          data-product-updates-badge\n          style=\"width: 0.5rem; height: 0.5rem;\"\n          aria-label=\"непрочитані оновлення продукту\"\n        ></span>\n      \n    </a>\n  </li>\n\n  <li>\n    \n      <a href=\"https://blog.djinni.co/?utm_source=djinni.co&utm_medium=djinni.co&utm_campaign=website_header_link\" target=\"_blank\" class=\"dropdown-item\">\n        Блог Djinni\n      </a>\n    \n  </li>\n\n  <li role=\"separator\" class=\"divider\"></li>\n\n  \n    \n      <li>\n        <a\n    