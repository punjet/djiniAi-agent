" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"/static/fonts/bi/bootstrap-icons.min.css\">\n<link rel=\"preload\" href=\"/static/fonts/bi/fonts/bootstrap-icons.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n  \n    <link rel=\"stylesheet\" href=\"/static/css/select2.min.css\">\n  \n\n\n\t\t\n      \n\n\n\n\n    <link rel=\"stylesheet\" href=\"/static/generated/css/bootstrap_5.CYvICRiA.css\" />\n  \n\n    <link rel=\"stylesheet\" href=\"/static/generated/css/theme_next.DVxLFaS-.css\" />\n    <link rel=\"stylesheet\" href=\"/static/generated/css/style.BMu9QVil.css\" />\n  \n\n\n  <style>\n    /* Diia logo theme swap. The `diia_logo_with_tooltip` macro\n       (components/helpers.html) renders `solid.svg` as the default `src`\n       (suits light theme). In dark theme we replace the rendered image via\n       CSS `content` — the `src`/`alt`/sizes are untouched. */\n    [data-bs-theme=\"dark\"] .js-diia-logo img {\n      content: url(\"/static/images/diia_logo/cyrillic/stroke.svg\");\n    }\n  </style>\n\n\t\t\n  \n    <link rel=\"stylesheet\" href=\"/static/generated/css/job_post.CX9ChZbH.css\" />\n  \n\n\n    \n      \n\n\n\n\n<script>\n  window.LANG = \"uk\";\n</script>\n<script src=\"/static/js/jquery-3.7.1.min.js\"></script>\n<script src=\"/static/js/jquery-migrate-3.4.0.min.js\"></script>\n<script src=\"/static/js/htmx-2.0.3.min.js\"></script>\n\n    \n    <script type=\"module\" src=\"/static/generated/js/htmx_bs_tooltips.CE6fZp96.js\" hx-history=\"false\"></script>\n  \n\n    \n    <script type=\"module\" src=\"/static/generated/js/htmx_loader.5rsQKbIh.js\" hx-history=\"false\"></script>\n  \n\n    \n    <script type=\"module\" src=\"/static/generated/js/htmx_config.qR035-wL.js\" hx-history=\"false\"></script>\n  \n\n\n    \n    <script type=\"module\" src=\"/static/generated/js/sentry.BB568TP9.js\" hx-history=\"false\"></script>\n  \n\n\n\n<script src=\"/static/js/bootstrap4.min.js\"></script>\n<script src=\"/static/js/bootstrap5.bundle.min.js\">