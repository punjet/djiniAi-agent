          "content": {
            "mimeType": "text/html; charset=utf-8",
            "size": 923,
            "text": "\n  <div class=\"js-cv-input-block\">\n    \n\n    <input\n  \t  type=\"file\"\n  \t  accept=\"application/pdf\"\n  \t  class=\"form-control py-1 js-cv-file-input\"\n  \t  name=\"cv_file\"\n  \t  maxlength=\"10000000\"\n  \t  id=\"cv_file_input\"\n  \t  \n  \t>\n    \n      <div class=\"form-text\">\n        Djinni приймає тільки резюме в форматі PDF і розміром до 10MB.\n      </div>\n    \n    \n      <div class=\"form-check mt-2\">\n        <input type=\"checkbox\" class=\"form-check-input\" name=\"save_profile_cv\" id=\"save_profile_cv\">\n        <label for=\"save_profile_cv\" class=\"form-check-label\">Зберегти це резюме в моєму профілі</label>\n      </div>\n    \n    \n      <a href=\"#\" role=\"button\" hx-get=\"/ajax/cv_select/?selected_id=2503101\" hx-target=\"closest .js-cv-input-block\" hx-swap=\"outerHTML\" class=\"small\">\n        &larr; Обрати зі своїх резюме\n      </a>\n    \n  </div>\n"
          },
