          "content": {
            "mimeType": "application/javascript; charset=utf-8",
            "size": 1017,
            "text": "// Dismiss elements with persistent localStorage storage\n//\n// USAGE:\n// \n// 1. Dismiss permanently (stored forever):\n//    <button data-storage-dismiss=\"#alert-123\">Dismiss</button>\n//    <div id=\"alert-123\">This alert will be dismissed and remembered permanently</div>\n//\n// 2. Dismiss temporarily (stored with expiration):\n//    <button data-storage-dismiss=\"#alert-456\" data-storage-dismiss-days=\"1\">Dismiss for 1 day</button>\n//    <button data-storage-dismiss=\"#alert-456\" data-storage-dismiss-days=\"7\">Dismiss for 1 week</button>\n//    <button data-storage-dismiss=\"#alert-456\" data-storage-dismiss-days=\"30\">Dismiss for 1 month</button>\n//    <div id=\"alert-456\">This alert will be dismissed and remembered temporarily</div>\n//\n// The script automatically:\n// - Stores all dismissals in localStorage for persistence across sessions/page reloads\n// - Hides previously dismissed elements on page load\n// - Shows temporarily dismissed elements again when the stored time expires\n// - Maintains dismissal state even after browser restart\n\nfunction init() {\n  // Check for previously dismissed elements and hide them\n  checkDismissedElements();\n\n  document.addEventListener(\"click\", function(event) {\n    const dismissTarget = event.target.getAttribute(\"data-storage-dismiss\");\n    const dismissDays = event.target.getAttribute(\"data-storage-dismiss-days\");\n    \n    if (dismissTarget) {\n      const targetElement = document.querySelector(dismissTarget);\n      if (targetElement) {\n        const elementId = dismissTarget.replace('#', '');\n        \n        if (dismissDays) {\n          // Dismiss temporarily for specified days\n          const dismissUntil = Date.now() + (parseInt(dismissDays) * 24 * 60 * 60 * 1000);\n          localStorage.setItem(`dismissTemporary-${elementId}`, dismissUntil.toString());\n        } else {\n          // Dismiss permanently\n          localStorage.setItem(`dismissPermanent-${elementId}`, \"true\");\n        }\n        \n        targetElement.remove();\n      }\n    }\n  });\n}\n\nfunction checkDismissedElements() {\n  // Find all elements with data-storage-dismiss attributes\n  const dismissButtons = document.querySelectorAll('[data-storage-dismiss]');\n  \n  dismissButtons.forEach(button => {\n    const targetId = button.getAttribute('data-storage-dismiss');\n    if (targetId) {\n      const elementId = targetId.replace('#', '');\n      const targetElement = document.querySelector(targetId);\n      \n      if (targetElement) {\n        // Check if permanently dismissed\n        const isPermanentlyDismissed = localStorage.getItem(`dismissPermanent-${elementId}`);\n        \n        // Check if temporarily dismissed\n        const dismissUntil = localStorage.getItem(`dismissTemporary-${elementId}`);\n        const isCurrentlyDismissed = dismissUntil && Date.now() < parseInt(dismissUntil);\n        \n        if (isPermanentlyDismissed === \"true\" || isCurrentlyDismissed) {\n          targetElement.remove();\n        } else if (dismissUntil && Date.now() >= parseInt(dismissUntil)) {\n          // Dismiss period expired, remove the temporary dismiss record\n          localStorage.removeItem(`dismissTemporary-${elementId}`);\n        }\n      }\n    }\n  });\n}\n\n\n// on document ready\ndocument.addEventListener('DOMContentLoaded', function() {\n  init();\n});\n"
          },
