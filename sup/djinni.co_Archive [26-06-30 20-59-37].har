rtal_card_title\":\"Looking for your company’s conversations?\",\"conversations_space_title\":\"Conversations\",\"copilot_multilingual_feature_description\":\"Use Fin AI Copilot in 45 different languages.\",\"copilot_multilingual_feature_short_title\":\"Multilingual\",\"copilot_multilingual_feature_title\":\"Multilingual\",\"copy\":\"Copy\",\"copy_to_clipboard\":\"Copy this code block to your clipboard.\",\"couldnt_load_app\":\"Couldn\\'t load the app.\",\"couldnt_load_apps\":\"Couldn\\'t load apps.\",\"couldnt_load_content\":\"Couldn\\'t load the content\",\"count_more\":\"{count} more\",\"create_a_ticket\":\"Create a ticket\",\"currently_no_help_articles\":\"There’s currently no help articles available.\",\"custom_actions_feature_description\":\"Call external APIs with custom actions.\",\"custom_actions_feature_short_title\":\"Custom actions\",\"custom_actions_feature_title\":\"Custom actions\",\"custom_answers_feature_description\":\"Fin can use human-written answers with embedded rich media like maps, external data, and custom actions to give you complete control over exactly how specific, high priority or critical questions should be answered.\",\"custom_answers_feature_short_title\":\"Custom Answers\",\"custom_answers_feature_title\":\"Custom Answers\",\"custom_call_reports_feature_description\":\"Create custom reports to dive deeper into call volume and performance data.\",\"custom_call_reports_feature_short_title\":\"Custom call reports\",\"custom_call_reports_feature_title\":\"Custom call reports\",\"custom_emojis\":\"Custom emojis\",\"custom_events_feature_description\":\"Track activity and changing data with custom events.\",\"custom_events_feature_short_title\":\"Custom events\",\"custom_events_feature_title\":\"Custom events\",\"custom_objects_feature_description\":\"Bring in business-critical data to power automated workflows.\",\"custom_objects_feature_short_title\":\"Custom objects\",\"custom_objects_feature_title\":\"Custom objects\",\"custom_report