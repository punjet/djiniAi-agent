tent\"></div>\n        </div>\n      </div>\n\n\t\t\t\n    </div>\n\n    \n      \n  \n  \n  \n  <script id=\"IntercomSettingsScriptTag\">\n    (function initIntercom() {\n      if (typeof intercomBooted !== \"undefined\") {\n        return;\n      }\n      \n      window.intercomSettings = {\n        app_id: \"cg6zpunb\",\n        language_override: 'uk',\n        \n          user_hash: \"cf2c124d09e94ea18c2889e7ef893a4dc5fd78865e6b4d50a22b5d8a34f4b5d0\",\n          created_at: 1776075947,\n\n          \n            email: \"hello@kirov.dev\",\n            user_id: 1095070,\n          \n\n          \n            'usertype': 'candidate',\n            'admin_status': 'online',\n            'employment': 'fulltime parttime',\n            \n              'salary_min': 1500,\n            \n            'name': 'Кирило',\n            'url': 'http://djinni.co/q/2c18b320bb',\n            'referral': 'https://www.google.com/',\n            'locale': 'uk',\n            'country': 'UKR',\n\n          \n\n        \n      };\n\n      var intercomBooted = Intercom.booted;\n      const intercomBtn = document.getElementById('intercom-link');\n      const intercomBtn2 = document.getElementById('intercom-link-2');\n      \n      // Function to setup intercom button\n      function setupIntercomButton(btn) {\n        if (btn) {\n          if (!intercomBooted) {\n            btn.classList.add('disabled');\n          }\n          Intercom('onUnreadCountChange', function() {\n            intercomBooted = true;\n            btn.classList.remove('disabled');\n          });\n\n          btn.addEventListener('click', function(event) {\n            event.preventDefault();\n            if (!intercomBooted) {\n              alert('Intercom не загрузився. Будь ласка, перевірте свої браузерні розширення які могли б блокувати його і спробуйте знову.')\n              return;\n            }\n\n            Intercom('show');\n          });\n\n          \n            const WAIT_FOR_INTERCOM = 5000;\n            setTimeout(function() {\n              btn.classList.remove('disabled');\n            }, WAIT_FOR_INTERCOM)\n          \n        }\n      }\n\n      // Setup both buttons\n      setupIntercomButton(intercomBtn);\n      setupIntercomButton(intercomBtn2);\n    })();\n  </script>\n\n    \n\n    \n      \n\t\t  \n    \n\n\t\t\n\n  \t\t\n    \n    <script type=\"module\" src=\"/static/generated/js/actions.Dj1nFdV6.js\" hx-history=\"false\"></script>\n  \n      \n    \n    <script type=\"module\" src=\"/static/generated/js/track_event.wH8AAQ4H.js\" hx-history=\"false\"></script>\n  \n      \n    \n    <script type=\"module\" src=\"/static/generated/js/inner.DHFXXEe5.js\" hx-history=\"false\"></script>\n  \n    \n\n\t\t\n  <script type=\"module\">\n    document\n      .querySelectorAll('[data-bs-toggle=\"popover\"]')\n      .forEach(function (el) {\n        new bootstrap.Popover(el, {\n          trigger: 'focus',\n          placement: 'bottom'\n        })\n      });\n\n    // Complain form\n    $(\".flag-candidate-btn\").on(\"click\", function (e) {\n      $(\".flag-candidate-btn\").toggle();\n      $(\".flag-candidate-form\").toggle();\n      e.preventDefault();\n    });\n\n    $(\".flag-candidate-dont-btn\").on(\"click\", function (e) {\n      $(\".flag-candidate-btn\").toggle();\n      $(\".flag-candidate-form\").toggle();\n      e.preventDefault();\n    });\n  </script>\n  \n    \n    <script type=\"module\" src=\"/static/generated/js/open_in_app.SQLsNeWE.js\" hx-history=\"false\"></script>\n  \n\n\n    \n  \n    <div\n      id=\"candidate-inbox-ws\"\n      data-ws-url=\"/ws/candidate/inbox/\"\n      data-candidate-id=\"985442\"\n    ></div>\n    <div id=\"candidate-notification-data\" style=\"display:none\"></div>\n    <script src=\"/static/js/htmx-ws-2.0.0.js\"></script>\n    <script src=\"/static/js/candidate-inbox-ws.js\"></script>\n  \n  \n\n\n\t\t\n\t\t\t\n  \n  \n\n\t\t\n\n\n    \n\n    \n  </body>\n</html>"
